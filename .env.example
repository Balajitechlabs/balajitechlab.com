# GitHub Personal Access Token (for GraphQL streak & contribution queries)
# Generate at: https://github.com/settings/tokens (classic token with 'read:user' or fine-grained token)
GITHUB_TOKEN=your_github_personal_access_token_here

# Telegram Bot Notifications (Instant Contact Form Alerts)
# 1. Create a bot with @BotFather on Telegram to get your TELEGRAM_BOT_TOKEN
# 2. Start a chat with your bot and find your numeric chat ID via @userinfobot to get TELEGRAM_CHAT_ID
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
